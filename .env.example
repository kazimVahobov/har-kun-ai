# Скопируйте в .env — он в .gitignore и в репозиторий не попадает.

# Порт бэкенда. Vite в разработке проксирует на него /api.
PORT=8787

# Понадобится только в фазе 3, когда подключится живая модель.
# До этого проект поднимается и работает без ключа (ADR 0003).
# Ключ читается только сервером и в браузер не попадает (ADR 0002).
OPENROUTER_API_KEY=
