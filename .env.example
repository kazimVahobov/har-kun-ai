# Copy to .env — that file is in .gitignore and never reaches the repository.
# Node reads it itself (--env-file-if-exists in the npm scripts); no dotenv needed.

# The backend's port. In development Vite proxies /api to it, reading this same
# file, so the two cannot drift apart.
PORT=8787

# The OpenRouter key: https://openrouter.ai/keys
# Read by the server only and never reaches the browser (ADR 0002) — the Network
# panel must show no request to openrouter.ai and no Authorization header on
# requests to our own API.
# With no key the project runs on the mock and works in full (ADR 0003).
OPENROUTER_API_KEY=

# Mock or the live model. Default: the mock without a key, the live model with one.
# MOCK=1 forces the mock even with a key; MOCK=0 means the live model, and
# without a key the server refuses to start.
# MOCK=

# The default model. Empty means the server picks one from the live free catalogue.
# OPENROUTER_MODEL=

# Where the OpenRouter API lives. Only worth setting to point at a proxy or a
# recorded fixture; the default is the real thing.
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional: OpenRouter shows these on its own dashboards.
# OPENROUTER_REFERER=https://har-kun.uz
# OPENROUTER_TITLE=Har Kun

# Watchdog timers, ms. The client's limits sit above the server's so the server
# fires first — it can still send a legible error.
# TIMEOUT_FIRST_TOKEN_MS=30000
# TIMEOUT_IDLE_MS=20000
# TIMEOUT_TOTAL_MS=120000

# How often the stream writes a keepalive comment, against proxies that cut idle
# connections.
# KEEPALIVE_MS=15000
