# Скопируйте в .env — он в .gitignore и в репозиторий не попадает.
# Node читает этот файл сам (--env-file-if-exists в npm-скриптах), dotenv не нужен.

# Порт бэкенда. Vite в разработке проксирует на него /api.
PORT=8787

# Ключ OpenRouter: https://openrouter.ai/keys
# Читается только сервером и в браузер не попадает (ADR 0002) — в Network-панели
# не должно быть ни запросов к openrouter.ai, ни заголовка Authorization.
# Без ключа проект поднимается на моке и полностью работает (ADR 0003).
OPENROUTER_API_KEY=

# Мок или живая модель. По умолчанию: мок, если ключа нет, живая модель, если есть.
# MOCK=1 — принудительно мок даже с ключом; MOCK=0 — живая модель, и без ключа
# сервер не стартует.
# MOCK=

# Модель по умолчанию. Пусто — сервер выберет из живого каталога бесплатных.
# OPENROUTER_MODEL=

# Необязательное: OpenRouter показывает их в своей статистике.
# OPENROUTER_REFERER=https://har-kun.uz
# OPENROUTER_TITLE=Har Kun

# Сторожевые таймеры, мс. Клиентские лимиты стоят выше серверных, чтобы первым
# срабатывал сервер — он ещё может прислать внятную ошибку.
# TIMEOUT_FIRST_TOKEN_MS=30000
# TIMEOUT_IDLE_MS=20000
# TIMEOUT_TOTAL_MS=120000
